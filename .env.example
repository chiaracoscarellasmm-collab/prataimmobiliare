# Copia questo file in .env.local e compila i valori reali.
# .env.local non va mai committato (è già in .gitignore).

# --- Cloudflare R2 (fotografie) -------------------------------------------
# Da Cloudflare dashboard → R2 → gestione API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Dominio pubblico del bucket (es. https://media.prataimmobiliare.it oppure
# https://pub-xxxxxxxx.r2.dev). Nessuna barra finale.
R2_PUBLIC_BASE_URL=

# --- Google Sheet (dati) ----------------------------------------------------
# Opzione A — link diretto "Pubblica sul web" in formato CSV del foglio Immobili:
GOOGLE_SHEET_CSV_URL=
# Opzione B — ID del foglio + nome tab (in alternativa a CSV_URL sopra):
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Immobili

# --- Google Sheets API (Service Account) ------------------------------------
# Opzione C — accesso via Google Sheets API con un Service Account, invece
# del link CSV pubblico. Il file JSON va in secrets/ (mai committato).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Immobili
